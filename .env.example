# ==========================================================
# HONEY PAY
# ENVIRONMENT VARIABLES
# V1.0.0
# ==========================================================
#
# IMPORTANTE:
# Este arquivo é apenas um modelo.
#
# NUNCA coloque passwords, tokens, chaves privadas ou
# credenciais reais neste arquivo.
#
# No ambiente local:
# copie este arquivo para ".env" e preencha os valores.
#
# No Render:
# configure estas variáveis diretamente em
# Environment Variables.
# ==========================================================


# ==========================================================
# APPLICATION
# ==========================================================

NODE_ENV=development

PORT=10000


# ==========================================================
# DATABASE
# ==========================================================

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/honey_pay?retryWrites=true&w=majority


# ==========================================================
# AUTHENTICATION
# ==========================================================
#
# Use uma chave longa e aleatória.
#
# Exemplo de geração:
#
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# NÃO utilize o exemplo abaixo como chave real.
# ==========================================================

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET


# ==========================================================
# CORS
# ==========================================================
#
# Desenvolvimento:
#
# CORS_ORIGIN=http://localhost:10000
#
# Produção:
#
# CORS_ORIGIN=https://seudominio.com
#
# Caso existam várias origens autorizadas, podem ser
# separadas por vírgulas.
# ==========================================================

CORS_ORIGIN=http://localhost:10000


# ==========================================================
# REQUEST LIMITS
# ==========================================================

MAX_JSON_SIZE=1mb

MAX_URLENCODED_SIZE=1mb


# ==========================================================
# FILE UPLOADS
# ==========================================================
#
# Estas configurações serão utilizadas quando o sistema
# de comprovativos for implementado.
# ==========================================================

MAX_UPLOAD_SIZE_MB=10

UPLOAD_DIRECTORY=uploads


# ==========================================================
# PUBLIC APPLICATION URL
# ==========================================================
#
# Desenvolvimento:
#
# PUBLIC_APP_URL=http://localhost:10000
#
# Produção:
#
# PUBLIC_APP_URL=https://seudominio.com
#
# Será utilizada posteriormente para gerar:
#
# - links de cobrança
# - checkout
# - QR Codes
# - recibos
# ==========================================================

PUBLIC_APP_URL=http://localhost:10000


# ==========================================================
# BUSINESS SETTINGS
# ==========================================================

FREE_INVOICE_LIMIT=10

PRO_MONTHLY_PRICE_KZ=7500


# ==========================================================
# SECURITY SETTINGS
# ==========================================================

AUTH_RATE_LIMIT_WINDOW_MS=900000

AUTH_RATE_LIMIT_MAX=20

UPLOAD_RATE_LIMIT_WINDOW_MS=900000

UPLOAD_RATE_LIMIT_MAX=30


# ==========================================================
# WHATSAPP
# ==========================================================
#
# Será configurado posteriormente quando implementarmos
# a integração WhatsApp.
#
# NUNCA coloque credenciais reais no GitHub.
# ==========================================================

WHATSAPP_ENABLED=false

WHATSAPP_PROVIDER=

WHATSAPP_API_URL=

WHATSAPP_API_TOKEN=

WHATSAPP_WEBHOOK_SECRET=


# ==========================================================
# APPLICATION FLAGS
# ==========================================================

ENABLE_REGISTRATION=true

ENABLE_PUBLIC_CHECKOUT=true

ENABLE_QR_CODES=true

ENABLE_RECEIPTS=true

ENABLE_HONEY_SHIELD=true
